# 이 파일(.env.example)은 커밋되는 "양식"이다. 실제 값을 여기에 적지 말 것.
#
# 사용법
#   1. 이 파일을 같은 위치(저장소 루트)에 .env 로 복사한다
#        PS> Copy-Item .env.example .env
#   2. .env 에 실제 값을 채운다
#   3. 끝. .env 는 .gitignore 대상이라 커밋되지 않는다
#
# 읽는 방법
#   backend-springboot/src/main/resources/application.yml 의 spring.config.import 가
#   저장소 루트의 .env 를 optional 로 읽는다. 파일이 없어도 앱은 그대로 뜬다.
#   추가로 backend-springboot/build.gradle 이 bootRun 에 이 파일의 절대경로를
#   넘기므로, 작업 디렉터리와 무관하게 같은 파일 하나를 바라본다.
#   (테스트는 로컬 값에 흔들리지 않도록 일부러 .env 를 읽지 않는다)
#   환경 변수와 달리 Gradle 데몬 재시작(--stop)이 필요 없다.
#
#   같은 이름의 OS 환경 변수가 있으면 그쪽이 이긴다(운영/컨테이너 배포 경로).
#   docker compose 는 이 .env 를 자동으로 읽어 컨테이너 환경 변수로 넘긴다.
#
# ── 작성 시 주의 (dotenv 가 아니라 .properties 문법으로 읽힌다) ──────
#   * 값을 따옴표로 감싸지 말 것.  MAIL_PASSWORD="abcd" 로 쓰면 따옴표까지 값이 된다
#   * 역슬래시 \ 는 이스케이프 문자다. 경로를 적을 땐 / 나 \\ 를 쓸 것
#   * ISO-8859-1 로 읽히므로 값에 한글을 쓰지 말 것 (비밀번호는 ASCII 로)
#   * # 으로 시작하는 줄은 주석, = 앞뒤 공백은 값에 포함되지 않는다

# ── PostgreSQL 접속 ────────────────────────────────────────────
# 작업 PC마다 Docker 호스트가 달라서(회사·집·학원) 여기서 주소를 맞춘다.
# 같은 PC에서 docker compose 로 띄웠다면 localhost, 다른 PC의 Docker 라면 그 PC의 IP.
# application.yml 이 이 두 값으로 jdbc:postgresql://HOST:PORT/board_db 를 만든다.
# 줄을 통째로 지우면 application.yml 의 기본값(192.168.29.124:5432)이 쓰인다.
# 반대로 줄은 두고 값만 비우면 빈 문자열이 그대로 호스트가 되어 접속이 깨진다.
PGSQL_HOST=192.168.29.124
PGSQL_PORT=5432

# ── SMTP : 네이버 메일 ──────────────────────────────────────────
# 네이버 메일 > 환경설정 > POP3/IMAP 설정 에서 "POP3/SMTP 사용함" 을 먼저 켜야 한다
# MAIL_SMTP_HOST 가 비어 있으면 실제 발송 대신 LoggingMailSender 가 본문을 로그로만 남긴다.
# 465 = 암묵적 SSL(SMTPS). 587(STARTTLS)로 바꾸려면 SSL=false, STARTTLS=true 로 함께 바꾼다.
MAIL_SMTP_HOST=smtp.naver.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SSL=true
MAIL_SMTP_STARTTLS=false

# 로그인 계정. 네이버는 앱 비밀번호를 발급받아 쓴다(로그인 비밀번호가 아니다).
MAIL_USERNAME=네이버아이디@naver.com
MAIL_PASSWORD=앱비밀번호

# 보내는 사람 주소. 네이버 SMTP 는 보통 MAIL_USERNAME 과 같은 주소만 허용한다.
MAIL_FROM_ADMIN=killme0u@gmail.com

# SMTP 대화 전체를 stdout 으로 찍는다. 인증 정보까지 남으므로 디버깅할 때만 true.
MAIL_DEBUG=false

# ── 메일 본문 링크의 기준 주소 ──────────────────────────────────
# 인증 링크·비밀번호 재설정 링크가 이 주소를 기준으로 만들어진다.
# 배포 시 외부에서 실제로 접근 가능한 주소로 바꾼다.
APP_BASE_URL=http://localhost:8080

# ── CAPTCHA (Cloudflare Turnstile) ────────────────────────────
# mode=fake 는 완전 오프라인 개발용이며 EXPECTED_TOKEN 과 일치하는 토큰만 통과시킨다.
# mode=remote 로 바꾸면 ENDPOINT/SECRET 을 실제 provider 값으로 채운다.
#
# 운영: Cloudflare Turnstile 대시보드에서 site key/secret 발급 후 아래를 채운다.
#   CAPTCHA_ENDPOINT=https://challenges.cloudflare.com/turnstile/v0/siteverify
#   CAPTCHA_SECRET=<발급받은 secret>
#   (프런트는 별도로 frontend-react/.env 의 VITE_TURNSTILE_SITE_KEY 에 site key를 채운다)
#
# 로컬에서 mode=remote 를 실제 네트워크 호출까지 포함해 테스트하고 싶다면,
# Cloudflare가 공개한 "항상 통과" 테스트 키를 계정 없이 그대로 쓸 수 있다:
#   CAPTCHA_ENDPOINT=https://challenges.cloudflare.com/turnstile/v0/siteverify
#   CAPTCHA_SECRET=1x0000000000000000000000000000000AA
#   (프런트 VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA — 위젯도 항상 통과)
CAPTCHA_MODE=fake
CAPTCHA_ENDPOINT=
CAPTCHA_SECRET=
CAPTCHA_EXPECTED_TOKEN=dev-captcha
